# MEXC Futures Bot v34.4.14 — STRICT PULLBACK + RISK GUARD
# Secrets MUST be configured in Railway Variables, not committed to source.
MEXC_ACCESS_KEY=
MEXC_SECRET_KEY=
BOT_ADMIN_TOKEN=

REAL_TRADING_ENABLED=true
AUTO_TRADING_ENABLED=true
SMART_PULLBACK_PROFILE=true

# Strict entry protection
REQUIRE_PULLBACK_ENTRY=true
EARLY_BREAKOUT_ENABLED=false
ENTRY_TRIGGER_PULLBACK_MAX_BARS=6
ENTRY_TRIGGER_MIN_PULLBACK_DEPTH_ATR=0.30
ENTRY_MOMENTUM_MIN_VOLUME=1.00
ENTRY_MOMENTUM_MIN_BODY_ATR=0.15
ENTRY_MOMENTUM_CLOSE_LOCATION=0.60
ENTRY_SR_MIN_ROOM_ATR=0.60
ENTRY_MAX_DISTANCE_E21_ATR=2.75
AUTO_INTERVAL_MINUTES=5

# Position limits
MAX_OPEN_POSITIONS=6
MAX_SAME_DIRECTION_POSITIONS=6
MAX_TRADES_PER_DAY=20

# Trading / target
TARGET_LEVERAGE=20
TAKE_PROFIT_PCT=0.02
ADAPTIVE_TP_ENABLED=true
ADAPTIVE_TP_MAX_PCT=0.04
ADAPTIVE_TP_STEP_PCT=0.015
ADAPTIVE_TP_EXTEND_TRIGGER_PCT=0.025

# Automatic SL protection
FORCE_AUTO_STOP_LOSS=true
MANUAL_STOP_LOSS=false
STOP_LOSS_PCT=0.0125
BREAK_EVEN_ENABLED=true
BREAK_EVEN_TRIGGER_PCT=0.01
BREAK_EVEN_OFFSET_PCT=0.002
TRAILING_STOP_ENABLED=true
TRAILING_TRIGGER_PCT=0.02
TRAILING_STOP_PCT=0.008
MIN_STOP_DISTANCE_PCT=0.001
STRUCTURE_STOP_MIN_PCT=0.005
MAX_STRUCTURE_STOP_PCT=0.0125

# Account-level risk guard
DAILY_DRAWDOWN_PROTECTION_ENABLED=true
MAX_DAILY_DRAWDOWN_PCT=0.03
MAX_LOSS_STREAK=2
LOSS_STREAK_COOLDOWN_MINUTES=60
ENTRY_COOLDOWN_ALL_TRADES=true
ENTRY_COOLDOWN_MINUTES=20

# Signal quality / market protection
HIGH_CONFIDENCE_MODE=true
HIGH_CONFIDENCE_MIN_SCORE=84
HIGH_CONFIDENCE_MIN_PRECISION=84
HIGH_CONFIDENCE_MIN_VOLUME=1.15
HIGH_CONFIDENCE_REQUIRE_DAILY_ALIGNMENT=true
HIGH_CONFIDENCE_REQUIRE_15M_ALIGNMENT=true
HIGH_CONFIDENCE_REQUIRE_1H_ALIGNMENT=true
MIN_SIGNAL_SCORE=80
MIN_PRECISION_SCORE=80
MIN_SCORE_EDGE=7
MIN_RISK_REWARD=1.60
REQUIRE_DAILY_ALIGNMENT=true
REQUIRE_15M_ALIGNMENT=true
REQUIRE_1H_ALIGNMENT=true
BREAKOUT_REQUIRE_VOLUME=true
MAX_ENTRY_SLIPPAGE_PCT=0.0025
MAX_SPREAD_PCT=0.0015
LIQUIDITY_MIN_24H_USDT=200000
VOLATILITY_SPIKE_ATR_MULTIPLIER=2.5

# Position manager
TRADE_MANAGER_ENABLED=true
TRADE_MANAGER_INTERVAL_SECONDS=10

# Optional defaults
DEFAULT_SYMBOL=SOL_USDT
INTERVAL=Min5
BOT_TIMEZONE=Asia/Kabul
