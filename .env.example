# MEXC Futures Bot v34.4.5
# Keep these OFF while testing signals:
REAL_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false

# Optional runtime settings
SMART_PULLBACK_PROFILE=true
AUTO_INTERVAL_MINUTES=5
MAX_OPEN_POSITIONS=1
BREAKOUT_REQUIRE_VOLUME=true
TARGET_LEVERAGE=20
# MEXC may cap leverage below 20x for some contracts; bot uses the contract max when lower.
